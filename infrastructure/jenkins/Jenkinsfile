// Jenkins CI/CD Pipeline for Price Aggregator Microservices
// Declarative Pipeline Syntax

pipeline {
    agent any
    
    environment {
        // Docker registry credentials (configure in Jenkins)
        DOCKER_REGISTRY = credentials('docker-registry-credentials')
        DOCKER_IMAGE_PREFIX = 'price-aggregator'
        
        // Environment variables
        COMPOSE_FILE = 'infrastructure/docker-compose.yml'
        COMPOSE_PROJECT_NAME = 'price-aggregator'
    }
    
    options {
        // Keep last 10 builds
        buildDiscarder(logRotator(numToKeepStr: '10'))
        
        // Timeout after 30 minutes
        timeout(time: 30, unit: 'MINUTES')
        
        // Disable concurrent builds
        disableConcurrentBuilds()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📦 Checking out source code...'
                checkout scm
                
                script {
                    // Get commit information
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    env.BUILD_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                }
            }
        }
        
        stage('Environment Check') {
            steps {
                echo '🔍 Verifying build environment...'
                sh '''
                    echo "Docker version:"
                    docker --version
                    
                    echo "Docker Compose version:"
                    docker compose version
                    
                    echo "Build Tag: ${BUILD_TAG}"
                '''
            }
        }
        
        stage('Build Services') {
            parallel {
                stage('Build Frontend') {
                    steps {
                        echo '🏗️ Building Frontend service...'
                        dir('frontend') {
                            sh """
                                docker build -t ${DOCKER_IMAGE_PREFIX}-frontend:${BUILD_TAG} .
                                docker tag ${DOCKER_IMAGE_PREFIX}-frontend:${BUILD_TAG} ${DOCKER_IMAGE_PREFIX}-frontend:latest
                            """
                        }
                    }
                }
                
                stage('Build Node Gateway') {
                    steps {
                        echo '🏗️ Building Node Gateway service...'
                        dir('node-gateway') {
                            sh """
                                docker build -t ${DOCKER_IMAGE_PREFIX}-gateway:${BUILD_TAG} .
                                docker tag ${DOCKER_IMAGE_PREFIX}-gateway:${BUILD_TAG} ${DOCKER_IMAGE_PREFIX}-gateway:latest
                            """
                        }
                    }
                }
                
                stage('Build Python Collector') {
                    steps {
                        echo '🏗️ Building Python Collector service...'
                        dir('python-collector') {
                            sh """
                                docker build -t ${DOCKER_IMAGE_PREFIX}-collector:${BUILD_TAG} .
                                docker tag ${DOCKER_IMAGE_PREFIX}-collector:${BUILD_TAG} ${DOCKER_IMAGE_PREFIX}-collector:latest
                            """
                        }
                    }
                }
            }
        }
        
        stage('Run Docker Compose Build') {
            steps {
                echo '🐳 Building services with Docker Compose...'
                dir('infrastructure') {
                    sh '''
                        docker compose build --no-cache
                    '''
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                echo '🔒 Running security scans...'
                script {
                    // Placeholder for security scanning
                    // In production: integrate tools like Trivy, Snyk, etc.
                    echo 'Security scanning (add Trivy or similar)'
                }
            }
        }
        
        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                script {
                    // Placeholder for test execution
                    // In production: run unit tests, integration tests
                    echo 'Testing stage (add test commands)'
                }
            }
        }
        
        stage('Push Images') {
            when {
                branch 'main'
            }
            steps {
                echo '📤 Pushing Docker images to registry...'
                script {
                    // Push to Docker registry (requires configuration)
                    // Uncomment when registry is configured
                    /*
                    sh """
                        docker push ${DOCKER_IMAGE_PREFIX}-frontend:${BUILD_TAG}
                        docker push ${DOCKER_IMAGE_PREFIX}-gateway:${BUILD_TAG}
                        docker push ${DOCKER_IMAGE_PREFIX}-collector:${BUILD_TAG}
                    """
                    */
                    echo 'Image push (configure Docker registry credentials)'
                }
            }
        }
        
        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                echo '🚀 Deploying services...'
                script {
                    // Deployment logic
                    // In production: deploy to Kubernetes, Docker Swarm, etc.
                    echo 'Deployment stage (add deployment commands)'
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ Pipeline completed successfully!'
            // Add notifications (Slack, email, etc.)
        }
        
        failure {
            echo '❌ Pipeline failed!'
            // Add failure notifications
        }
        
        always {
            echo '🧹 Cleaning up...'
            sh '''
                # Clean up dangling images
                docker image prune -f
            '''
        }
    }
}
