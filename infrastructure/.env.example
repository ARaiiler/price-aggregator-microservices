# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control

# ============================================
# Application Environment
# ============================================
ENVIRONMENT=production
NODE_ENV=production

# ============================================
# Service Ports
# ============================================
FRONTEND_PORT=3000
NODE_GATEWAY_PORT=5000
# Python collector binds inside the container on SERVICE_PORT (no host port exposed)
SERVICE_PORT=8000

# ============================================
# Logging
# ============================================
# Uvicorn / Node log verbosity: debug | info | warning | error | critical
LOG_LEVEL=info

# ============================================
# MongoDB Configuration
# ============================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=priceaggregator
MONGO_URI=mongodb://admin:yourpassword@mongodb:27017/priceaggregator?authSource=admin

# ============================================
# Redis Configuration
# ============================================
# Individual parts — used by the Python Collector to assemble redis_url.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL — used by the Node.js Gateway and overrides host/port above.
REDIS_URL=redis://:yourpassword@redis:6379/0

# ============================================
# JWT Authentication
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=

# ============================================
# Service URLs (Internal)
# ============================================
PYTHON_SERVICE_URL=http://python-collector:8000
FRONTEND_URL=http://localhost:3000

# ============================================
# Optional: External API Keys
# ============================================
# Add any third-party API keys here
# EXAMPLE_API_KEY=
