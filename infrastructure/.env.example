# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control

# ============================================
# Application Environment
# ============================================
ENVIRONMENT=production
NODE_ENV=production

# ============================================
# Service Ports
# ============================================
FRONTEND_PORT=3000
NODE_GATEWAY_PORT=5000
# Python collector runs on 8000 internally (not exposed)

# ============================================
# MongoDB Configuration
# ============================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=priceaggregator
MONGO_URI=mongodb://admin:yourpassword@mongodb:27017/priceaggregator?authSource=admin

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=
REDIS_URL=redis://:yourpassword@redis:6379/0

# ============================================
# JWT Authentication
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_change_me

# ============================================
# Service URLs (Internal)
# ============================================
PYTHON_SERVICE_URL=http://python-collector:8000
FRONTEND_URL=http://localhost:3000

# ============================================
# Optional: External API Keys
# ============================================
# Add any third-party API keys here
# EXAMPLE_API_KEY=
INTERNAL_API_KEY=changeme-internal-key
