# ── Python Collector Service ────────────────────────────
# Copy this file to .env and fill in real values.

# Shared secret between Node.js gateway and this service
INTERNAL_API_KEY=changeme-internal-key

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
PRICE_HISTORY_TTL=86400

# Target currency for price normalisation
DEFAULT_CURRENCY=MAD

# (Optional) API key for live exchange rates
RAPIDAPI_KEY=

# Debug mode (True / False)
DEBUG=False
