# =============================================================================
# Python Data Collector Service — environment variable reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Docker Compose / Kubernetes, supply these values via the
# ``environment:`` block or a secrets manager instead of a .env file.
#
# NEVER commit a populated .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
SERVICE_NAME=python-collector
SERVICE_VERSION=1.0.0

# Environment tag: development | staging | production
# OpenAPI docs (/docs, /redoc) are disabled when set to "production".
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port uvicorn listens on inside the container.
# Must match the port referenced in docker-compose healthcheck and
# the HEALTHCHECK instruction in the Dockerfile.
SERVICE_PORT=8000

# Uvicorn log verbosity: debug | info | warning | error | critical
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Redis — individual parts (preferred)
# -----------------------------------------------------------------------------
# Use REDIS_HOST + REDIS_PORT + REDIS_PASSWORD.
# The application assembles redis_url automatically from these three values.
# Leave REDIS_PASSWORD blank only when Redis is configured without auth
# (acceptable for local development, never for production).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Redis — full URL (optional override)
# -----------------------------------------------------------------------------
# Set REDIS_URL to override the assembled URL above.
# Useful when Redis is provided by a managed service with a connection string.
# Format: redis://[:password@]host[:port][/db-number]
# Example (with auth):    redis://:s3cr3t@redis.example.com:6379/0
# Example (no auth):      redis://localhost:6379/0
# Leave blank to let the service build the URL from REDIS_HOST/PORT/PASSWORD.
REDIS_URL=

# -----------------------------------------------------------------------------
# Cache TTLs
# -----------------------------------------------------------------------------
# How long a latest_price:{name} key lives in Redis (seconds).
# After this window, the next search re-fetches from all sources.
LATEST_PRICE_TTL_SECONDS=600

# How long any generic cached result lives (seconds).
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Scraper behaviour
# -----------------------------------------------------------------------------
# Maximum seconds to wait for a single data source to respond.
SCRAPER_TIMEOUT_SECONDS=10.0

# Minimum number of sources that must return results before caching.
MIN_SOURCES_REQUIRED=2
